<?xml version="1.0" encoding="utf-8"?>
<!--
  Picker preview. Rendered by the launcher with no data behind it, so the sample copy here mirrors
  the shape of the real widget: one fact per row, none of them repeating the eyebrow.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="4dp"
    android:background="@drawable/flixquest_widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:layout_width="@dimen/widget_poster_width"
        android:layout_height="@dimen/widget_poster_height"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="14dp"
        android:background="@drawable/flixquest_widget_poster_background"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/figtree_family"
            android:letterSpacing="0.09"
            android:maxLines="1"
            android:text="CONTINUE WATCHING"
            android:textColor="#FFF57C00"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:fontFamily="@font/figtree_family"
            android:maxLines="2"
            android:text="Right where you left off"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:fontFamily="@font/figtree_family"
            android:maxLines="1"
            android:text="S2 E4  ·  The episode title"
            android:textColor="#E6FFFFFF"
            android:textSize="12sp" />

        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="9dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="78"
            android:progressBackgroundTint="#40FFFFFF"
            android:progressDrawable="@drawable/flixquest_widget_progress"
            android:progressTint="#FFF57C00" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:ellipsize="end"
            android:fontFamily="@font/figtree_family"
            android:maxLines="2"
            android:text="18m left"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
