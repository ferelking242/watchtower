<?xml version="1.0" encoding="utf-8"?>
<paths>
    <external-path path="Android/data/com.watchtower.app/" name="files_root" />
    <external-path path="." name="external_storage_root" />
    <!-- github_release_apk_updater package requires external-path for APK install -->
    <external-path name="external_files" path="." />
    <!-- App updates land in <storage>/watchtower/update, but keep the
         app-scoped fallbacks covered too: FileProvider throws when the APK
         sits outside every declared root, and the install intent then never
         launches. -->
    <files-path name="internal_files" path="." />
    <cache-path name="internal_cache" path="." />
    <external-files-path name="external_app_files" path="." />
    <external-cache-path name="external_app_cache" path="." />
</paths>
